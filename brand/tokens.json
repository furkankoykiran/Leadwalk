{
  "$description": "Leadwalk design tokens. Source: shared/brand.ts and app/assets/css/main.css.",
  "brand": {
    "accent": {
      "$type": "color",
      "$value": "#C2410C",
      "$description": "Route orange. Primary actions, the mark container."
    },
    "accent-dark": {
      "$type": "color",
      "$value": "#FB923C",
      "$description": "Accent on dark grounds."
    },
    "ink": {
      "$type": "color",
      "$value": "#1C1917",
      "$description": "Primary text and the wordmark on light grounds."
    },
    "paper": {
      "$type": "color",
      "$value": "#FBF8F4",
      "$description": "Light ground."
    },
    "night": {
      "$type": "color",
      "$value": "#141210",
      "$description": "Dark ground."
    },
    "teal": {
      "$type": "color",
      "$value": "#0F766E",
      "$description": "Won / trust. Never used for primary actions."
    },
    "line": {
      "$type": "color",
      "$value": "#ECE6DE",
      "$description": "Hairlines and card borders."
    },
    "muted": {
      "$type": "color",
      "$value": "#6B635B",
      "$description": "Secondary text (4.6:1 on paper)."
    }
  },
  "stage": {
    "new": {
      "$type": "color",
      "$value": "#A8A29E"
    },
    "prepared": {
      "$type": "color",
      "$value": "#7C3AED"
    },
    "visited": {
      "$type": "color",
      "$value": "#0369A1"
    },
    "won": {
      "$type": "color",
      "$value": "#0F766E"
    },
    "lost": {
      "$type": "color",
      "$value": "#DC2626"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Plus Jakarta Sans",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "weight-regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "weight-semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "weight-bold": {
      "$type": "fontWeight",
      "$value": 700
    },
    "weight-extrabold": {
      "$type": "fontWeight",
      "$value": 800
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "card": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "panel": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "mark-ratio": {
      "$type": "number",
      "$value": 0.21875,
      "$description": "Mark container corner radius ÷ size."
    }
  }
}
