{
  "name": "leadwalk",
  "version": "0.1.0",
  "description": "Open-source field-sales workspace: find local businesses, rank who needs you most, walk in with a tailored pitch.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkankoykiran/Leadwalk.git"
  },
  "bugs": {
    "url": "https://github.com/furkankoykiran/Leadwalk/issues"
  },
  "homepage": "https://github.com/furkankoykiran/Leadwalk#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt prepare && vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "nuxt prepare",
    "test:e2e": "playwright test --grep-invert @docs",
    "test:e2e:offline": "playwright test --grep-invert \"@live|@docs\"",
    "brand:build": "node brand/tools/build-brand-kit.mjs",
    "docs:screenshots": "playwright test --grep @docs --project tr-istanbul --no-deps"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@nuxt/image": "^2.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/google.maps": "^3.66.10",
    "eslint": "^10.14.0",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.14"
  }
}
